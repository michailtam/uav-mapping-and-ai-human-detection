    <joint name="back_prop_ccw_joint" type="revolute">
      <pose relative_to="base_link">-0.2287 0.23276 0.086501 0 0 0</pose>
      <parent>base_link</parent><child>back_prop_ccw_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
